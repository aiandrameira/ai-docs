{
    "name": "@aiandralves/ai-docs",
    "version": "0.0.8",
    "description": "A comprehensive Angular UI component library with Tailwind CSS",
    "repository": {
        "type": "git",
        "url": "https://github.com/aiandrameira/ai-docs"
    },
    "author": "Aiandra Alves <aiandraalves.meira@gmail.com>",
    "license": "MIT",
    "keywords": [
        "ai-ui",
        "angular",
        "typescript",
        "tailwindcss"
    ],
    "homepage": "https://ai-ui.aiandralves.com.br/",
    "type": "commonjs",
    "main": "./index.cjs",
    "types": "./src/index.d.ts",
    "bin": {
        "ai-docs": "index.cjs"
    },
    "dependencies": {
        "mermaid": "^11.16.0"
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./index.cjs"
        },
        "./config": {
            "types": "./src/config.d.ts",
            "default": "./config.cjs"
        }
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    }
}